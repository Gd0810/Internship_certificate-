# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# The hidden, unlisted URL prefix for the company portal. Change this to
# something unguessable before deploying, and share it with the company
# out of band (never link it anywhere on the public site).
COMPANY_PORTAL_SLUG=

# Leave DATABASE_URL empty to use local SQLite. Set it in production, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Leave REDIS_URL empty to use local in-memory cache. Set it in production, e.g.:
# REDIS_URL=redis://host:6379/0
REDIS_URL=

# Razorpay — get these from your Razorpay dashboard (test keys to start).


RAZORPAY_KEY_ID =
RAZORPAY_KEY_SECRET = 

MAX_TEMPLATE_ZIP_SIZE_MB=15

# Only used when DJANGO_DEBUG=False
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# PDF rendering engine: "auto" (default, recommended), "weasyprint", or
# "xhtml2pdf". auto tries WeasyPrint first and falls back automatically if
# its native libraries aren't installed (common on Windows).
PDF_ENGINE=auto
